{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CountriesResponse",
  "description": "Схема ответа API Aviasales/Travelpayouts для списка стран",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "code",
      "name",
      "currency"
    ],
    "properties": {
      "code": {
        "type": "string",
        "description": "IATA-код страны (двухбуквенный)",
        "minLength": 2,
        "maxLength": 2
      },
      "name": {
        "type": "string",
        "description": "Название страны"
      },
      "currency": {
        "type": "string",
        "description": "Валюта страны (трехбуквенный код)"
      },
      "name_translations": {
        "type": "object",
        "description": "Переводы названия страны на разные языки",
        "additionalProperties": {
          "type": "string"
        }
      },
      "cases": {
        "type": "object",
        "description": "Падежи названия страны (da, pr, ro, su, tv, vi)",
        "additionalProperties": {
          "type": "string"
        }
      }
    },
    "additionalProperties": false
  }
}